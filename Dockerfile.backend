FROM maven:3.9.9-eclipse-temurin-8 AS builder

WORKDIR /workspace
COPY pom.xml ./
COPY sky-common/pom.xml sky-common/pom.xml
COPY sky-pojo/pom.xml sky-pojo/pom.xml
COPY sky-server/pom.xml sky-server/pom.xml
RUN mvn -B -ntp dependency:go-offline

COPY sky-common/src sky-common/src
COPY sky-pojo/src sky-pojo/src
COPY sky-server/src sky-server/src
RUN mvn -B -ntp -pl sky-server -am -DskipTests package

FROM eclipse-temurin:8-jre-alpine

WORKDIR /app
# Java 8 gets its elliptic-curve algorithms from libsunec.so, which needs libgcc_s. Without it the JVM
# offers no ECDHE or ECDSA in TLS, and servers that require them, such as TiDB Cloud, end the handshake.
RUN apk add --no-cache libgcc
RUN addgroup -S sky && adduser -S sky -G sky
COPY --from=builder /workspace/sky-server/target/sky-server-*.jar /app/sky-server.jar
# The settings ship with the image, so it also runs where nothing mounts the file, such as Render.
# The compose files mount the same file over it.
COPY docker/backend/application.yml /app/config/application.yml
USER sky

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/sky-server.jar", "--spring.config.location=file:/app/config/application.yml"]

